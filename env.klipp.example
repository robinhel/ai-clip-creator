# Lägg de här raderna i filen .env i projektmappen.
# .env får ALDRIG checkas in i git eller klistras in i en chatt.

# --- Används av clipsmith och av kampanjlagret ---
ANTHROPIC_API_KEY=

# Twitch-nycklar: behövs för att hämta VODs och tittarnas klipp.
# Skapa på https://dev.twitch.tv/console (Register Your Application, OAuth Redirect: http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Bara kampanjlagret ---
KLIPP_PROFILE=skiimasktimmy
KLIPP_REVIEW_MODEL=claude-haiku-5-5

# Budgetspärr i dollar (Anthropic räknar i dollar). Räkna om dina 200 euro med dagens kurs,
# eller låt 200 stå kvar som ett försiktigt startvärde.
# Sätt också en utgiftsgräns i Claude Console. Den är det säkraste stoppet.
BUDGET_USD_PER_MONTH=200
BUDGET_USD_PER_DAY=10

# Videokodare: libx264 (fungerar överallt) | h264_nvenc (NVIDIA) | h264_videotoolbox (Mac)
KLIPP_ENCODER=libx264
