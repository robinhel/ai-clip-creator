# clipsmith secrets — copy this file to .env and fill in your key.
# Run `clipsmith setup` to do this interactively.

# LLM provider key (set the one you use)
#ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Twitch credentials — only needed for `watch` / `run-vod` (not for `process`)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# API server security — both optional; leave blank for local dev (no auth enforced)
# CLIPSMITH_API_KEY=          # When set, POST /runs, PATCH /clips, POST /publish require X-Api-Key header
# CORS_ORIGINS=http://localhost:3000  # Comma-separated allowed origins; defaults to http://localhost:3000,http://127.0.0.1:3000

# Transcription — Settings > Transcription saves these. Neither is secret.
# berget: Berget in the cloud (fast, needs BERGET_API_KEY). local: faster-whisper on this computer (free, slower).
# Empty: berget if BERGET_API_KEY is set, otherwise local.
# TRANSCRIBE_ENGINE=
# BERGET_API_KEY=
# Local model: small (about 0.5 GB, default) | medium (1.5 GB) | large-v3 (3 GB). Downloaded the first time;
# with small a 4 h VOD takes about 30-90 minutes on an ordinary CPU.
# LOCAL_WHISPER_MODEL=small

# TikTok — optional; uploads approved clips as drafts to the TikTok inbox.
# The keys are under the app on developers.tiktok.com (Login Kit + Content Posting API).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
