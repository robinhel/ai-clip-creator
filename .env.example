# clipsmith secrets — copy this file to .env and fill in your key.
# Run `clipsmith setup` to do this interactively.

# LLM provider key (set the one you use)
#ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Twitch credentials — only needed for `watch` / `run-vod` (not for `process`)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# API server security — both optional; leave blank for local dev (no auth enforced)
# CLIPSMITH_API_KEY=          # When set, POST /runs, PATCH /clips, POST /publish require X-Api-Key header
# CORS_ORIGINS=http://localhost:3000  # Comma-separated allowed origins; defaults to * (open)

# TikTok — optional; laddar upp godkända klipp som utkast till TikTok-inkorgen.
# Nycklarna finns under appen på developers.tiktok.com (Login Kit + Content Posting API).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
